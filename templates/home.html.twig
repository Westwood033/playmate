{% extends 'base.html.twig' %}

{% block title %}Accueil | Playmate{% endblock %}

{% block body %}
    {% include 'header.html.twig' %}

    <main class="page">
        <div class="container">

            {# ================= TOURNAMENTS ================= #}
            <section class="mb-8">
                <div class="card">
                    <div class="mb-4">
                        <h2 class="section-title">Mes tournois à venir</h2>
                    </div>

                    {% if tournaments is defined and tournaments|length > 0 %}
                        <div class="grid grid-3">
                            {% for tournament in tournaments %}
                                <article class="panel">
                                    <h3 class="mb-2">{{ tournament.name }}</h3>

                                    <p class="small mb-1">
                                        <strong>Date :</strong>
                                        {{ tournament.tournamentDate ? tournament.tournamentDate|date('d/m/Y H:i') : 'À confirmer' }}
                                    </p>

                                    <p class="small mb-0">
                                        <strong>Lieu :</strong>
                                        {{ tournament.address ?? 'Lieu non précisé' }}
                                    </p>
                                </article>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted">Aucun tournoi inscrit pour le moment.</p>
                    {% endif %}
                </div>
            </section>

            <div class="grid" style="grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr); align-items: start;">

                {# ================= NEWS ================= #}
                <section class="stack-lg">
                    <div class="card">
                        <div class="mb-4">
                            <h2 class="section-title">Actualités</h2>
                        </div>

                        {% if newsArticles is defined and newsArticles|length > 0 %}
                            <div class="stack-lg">
                                {% for article in newsArticles %}
                                    <article class="panel">
                                        <h3 class="mb-2">{{ article.title }}</h3>

                                        {% if article.publishedAt is defined and article.publishedAt %}
                                            <p class="small text-muted mb-2">
                                                Publié le {{ article.publishedAt|date('d/m/Y') }}
                                            </p>
                                        {% endif %}

                                        <p class="mb-4 text-muted">
                                            {{ article.excerpt ?? article.content|slice(0, 180) ~ '...' }}
                                        </p>

                                        {% if article.url is defined and article.url %}
                                            <a href="{{ article.url }}" class="btn btn-secondary">Lire l’article</a>
                                        {% endif %}
                                    </article>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted">Aucune actualité disponible.</p>
                        {% endif %}
                    </div>
                </section>

                {# ================= SIDEBAR ================= #}
                <aside class="stack-lg">

                    {# ================= CAROUSEL ================= #}
                    <section class="card">
                        <div class="mb-4">
                            <h2 class="section-title">Dernières cartes en vente</h2>
                        </div>

                        {% if latestItems is defined and latestItems|length > 0 %}
                            <div id="latest-items-carousel" class="carousel slide" data-bs-interval="false">
                                <div class="carousel-inner">
                                    {% for item in latestItems %}
                                        {% set image = item.images|length ? item.images[0] : '/images/items/placeholder.jpg' %}

                                        <div class="carousel-item {% if loop.first %}active{% endif %}">
                                            <div class="carousel-card-wrap">
                                                <article class="market-card">
                                                    <div class="market-card__image-wrap">
                                                        <img src="{{ asset(image) }}" alt="{{ item.name }}" class="market-card__image">
                                                    </div>

                                                    <div class="market-card__content">
                                                        <h3 class="market-card__title">{{ item.name }}</h3>
                                                        <p class="market-card__description">{{ item.description }}</p>
                                                        <p class="market-card__price">{{ item.price }} €</p>
                                                    </div>
                                                </article>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <p class="text-muted">Aucune carte en vente récemment.</p>
                        {% endif %}
                    </section>

                    {# ================= CALENDRIER ================= #}
                    <section class="card">

                        <div class="mb-4">
                            <h2 class="section-title">Calendrier des événements</h2>

                            <div class="calendar-header">
                                <button type="button" class="calendar-nav" id="prev">‹</button>
                                <h3 class="calendar-title" id="calendarTitle"></h3>
                                <button type="button" class="calendar-nav" id="next">›</button>
                            </div>
                        </div>

                        <div class="calendar-wrapper">
                            <div class="calendar-grid">

                                <div class="calendar-weekday">L</div>
                                <div class="calendar-weekday">M</div>
                                <div class="calendar-weekday">M</div>
                                <div class="calendar-weekday">J</div>
                                <div class="calendar-weekday">V</div>
                                <div class="calendar-weekday">S</div>
                                <div class="calendar-weekday">D</div>

                                <div id="calendarDays" style="display: contents;"></div>

                            </div>
                        </div>

                    </section>

                </aside>
            </div>
        </div>
    </main>

   {# ================= DATA TOURNOIS ================= #}
<script>
/* =========================
   DONNÉES TOURNAMENTS
========================= */
const tournaments = [
    {% for tournament in tournaments %}
        {
            id: {{ tournament.id }},
            date: "{{ tournament.tournamentDate ? tournament.tournamentDate|date('Y-m-d') : '' }}",
            name: "{{ tournament.name|e('js') }}"
        },
    {% endfor %}
];

/* map : date => tournoi */
const tournamentMap = {};

tournaments.forEach(t => {
    if (t.date) {
        tournamentMap[t.date] = t;
    }
});

/* =========================
   CALENDRIER
========================= */
let date = new Date();

const months = [
    "Janvier","Février","Mars","Avril","Mai","Juin",
    "Juillet","Août","Septembre","Octobre","Novembre","Décembre"
];

function renderCalendar() {
    const year = date.getFullYear();
    const month = date.getMonth();

    // titre mois + année
    document.getElementById("calendarTitle").innerText =
        months[month] + " " + year;

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    let html = "";

    // correction pour commencer lundi
    let start = firstDay === 0 ? 6 : firstDay - 1;

    // cases vides avant le 1er jour
    for (let i = 0; i < start; i++) {
        html += `<div></div>`;
    }

    // jours du mois
    for (let d = 1; d <= daysInMonth; d++) {

        const dayStr =
            year + "-" +
            String(month + 1).padStart(2, "0") + "-" +
            String(d).padStart(2, "0");

        const tournament = tournamentMap[dayStr];

        html += `
            <div class="calendar-day ${tournament ? 'calendar-day--tournament' : ''}"
                 data-id="${tournament ? tournament.id : ''}"
                 title="${tournament ? tournament.name : ''}">
                ${d}
            </div>
        `;
    }

    document.getElementById("calendarDays").innerHTML = html;
}

/* =========================
   NAVIGATION MOIS
========================= */
document.getElementById("prev").addEventListener("click", () => {
    date.setMonth(date.getMonth() - 1);
    renderCalendar();
});

document.getElementById("next").addEventListener("click", () => {
    date.setMonth(date.getMonth() + 1);
    renderCalendar();
});

/* =========================
   CLICK → REDIRECTION
========================= */
document.addEventListener("click", function (e) {
    const day = e.target.closest(".calendar-day");
    if (!day) return;

    const id = day.dataset.id;

    if (id) {
        window.location.href = "/tournament/" + id;
    }
});

/* =========================
   INIT
========================= */
renderCalendar();
</script>

{% endblock %}