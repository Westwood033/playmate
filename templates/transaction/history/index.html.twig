{% extends 'base.html.twig' %}

{% block title %}Articles — Playmate
{% endblock %}

{% block body %}
	{% include 'header.html.twig' %}

	<main class="page">
		<div class="container">
			<div class="transactions-page">

				{% for msg in app.flashes('success') %}
					<div class="alert alert-success">{{ msg }}</div>
				{% endfor %}

				<div class="transactions-grid">
					{% for transaction in transactions %}
						<a href="{{ path('item_show', {id: transaction.item.id}) }}" class="transaction-card {% if transaction.item.sold %}transaction-card--sold{% endif %}">
							<div class="transaction-card__body">
								<h2 class="transaction-card__name">
									Produit :
									{{ transaction.item.name }}
								</h2>

								<p class="transaction-card__price">
									Prix :
									{{ transaction.item.price|number_format(2, ',', ' ') }}
									€
								</p>

								<p class="transaction-card__address">
									Adresse de livraison :
									{{ transaction.address }}
								</p>

								<p class="transaction-card__seller">
									Adresse du vendeur :
									{{ transaction.seller.address }}
								</p>
							</div>
						</a>
					{% else %}
						<p class="text-muted">Aucune transaction disponible.</p>
					{% endfor %}
				</div>

			</div>
		</div>
	</main>
{% endblock %}
