<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Playmate</title>
</head>
<body style="margin:0;padding:0;background-color:#f9f9f9;">

<!-- Wrapper -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9f9f9;">
    <tr>
        <td align="center" style="padding:20px 12px;">

            <!-- Card wrapper: radius/shadow for clients that support it, harmless for Outlook desktop -->
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                   style="
                     width:600px;max-width:600px;
                     border-collapse:separate;
                     background-color:#ffffff;
                     border:1px solid #dddddd;
                     border-radius:8px;
                     box-shadow:0 4px 6px rgba(0,0,0,0.10);
                   ">
                <tr>
                    <td style="padding:0;">

                        <!-- Inner layout table (keeps Outlook happy) -->
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                               style="width:100%;border-collapse:collapse;">

                            <!-- Header -->
                            <tr>
                                <td style="padding:0;">

                                    <!-- Header wrapper to clip corners -->
                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                           style="width:100%;border-collapse:separate;border-radius:8px 8px 0 0;overflow:hidden;">
                                        <tr>
                                            <td align="center" style="background-color:#51e815;padding:20px;border-radius:8px 8px 0 0;">
                                                <div style="font-family:Arial,sans-serif;font-size:22px;line-height:1.2;font-weight:bold;color:#ffffff;">
                                                    Playmate - Achat confirmé
                                                </div>
                                            </td>
                                        </tr>
                                    </table>

                                </td>
                            </tr>

                            <!-- Content -->
                            <tr>
                                <td style="padding:20px;font-family:Arial,sans-serif;font-size:14px;line-height:1.6;color:#333333;">

                                    <p style="margin:0 0 16px 0;">
                                        Bonjour,
                                    </p>

                                    <p style="margin:0 0 16px 0;">
                                        Votre achat de l'élément suivant est confirmé :
                                    </p>

                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;">
                                        <tr>
                                            <td style="padding:4px 12px 4px 0;"><strong>Nom :</strong></td>
                                            <td style="padding:4px 0;">{{ itemName }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px 12px 4px 0;"><strong>Prix :</strong></td>
                                            <td style="padding:4px 0;">{{ itemPrice }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px 12px 4px 0;"><strong>Vendeur :</strong></td>
                                            <td style="padding:4px 0;">{{ itemSeller }}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding:4px 12px 4px 0;"><strong>Adresse de livraison :</strong></td>
                                            <td style="padding:4px 0;">{{ buyerAddress }}</td>
                                        </tr>
                                    </table>

                                    <p style="margin:0 0 16px 0;">
                                        Le vendeur vous contactera pour plus d'informations à propos de l'expédition, et vous serez débité sous peu.
                                    </p>

                                    <p style="margin:0 0 16px 0;">
                                        Merci pour votre confiance.
                                    </p>

                                    <p style="margin:0;">
                                        Cordialement,<br>
                                        <strong>Playmate</strong>
                                    </p>

                                </td>
                            </tr>

                            <!-- Logo section -->
                            <tr>
                                <td align="center" style="padding:20px;background-color:#ffffff;">
                                    <img src="{{ absolute_url(asset('logo.jpg')) }}" alt="Logo Playmate"
                                         width="150"
                                         style="display:block;border:0;outline:none;text-decoration:none;height:auto;">
                                </td>
                            </tr>

                            <!-- Footer -->
                            <tr>
                                <td align="center" style="padding:10px;background-color:#f4f4f4;">
                                    <div style="font-family:Arial,sans-serif;font-size:12px;line-height:1.4;color:#666666;">
                                        &copy; 2026 Playmate. Tous droits réservés.
                                    </div>
                                </td>
                            </tr>

                        </table>
                        <!-- /Inner layout table -->

                    </td>
                </tr>
            </table>

        </td>
    </tr>
</table>

</body>
</html>
