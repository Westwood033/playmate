
{% block title %}Créer un Tournoi
{% endblock %}

{% block  body %}

{% for flash_error in app.flashes('verify_email_error') %}
					<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
				{% endfor %}

{{ form_errors(form) }}


{{ form_start(form, {'attr': {'class': 'auth-form'}}) }}
	<div class="form-group">
		{{ form_label(form.name) }}
		{{ form_widget(form.name, {'attr': {'placeholder': 'ex : Évènement TCC'}}) }}
		{{ form_errors(form.name) }}
	</div>

	<div class="form-group">
		{{ form_label(form.description) }}
		{{ form_widget(form.description, {'attr': {'placeholder': 'ex : Échange de carte...'}}) }}
		{{ form_errors(form.description) }}
	</div>

	<div class="form-group">
		{{ form_label(form.tournamentDate) }}
		{{ form_widget(form.tournamentDate) }}
		{{ form_errors(form.tournamentDate) }}
	</div>

	<div class="form-group">
		{{ form_label(form.participantNumber) }}
		{{ form_widget(form.participantNumber, {'attr': {'value': 1}}) }}
		{{ form_errors(form.participantNumber) }}
	</div>

	<div class="form-group">
		{{ form_label(form.street) }}
		{{ form_widget(form.street, {'attr': {'placeholder': 'Adresse', 'value': street is defined ? street}}) }}
		{{ form_errors(form.street) }}

		<div class="location-row">
			<div>
				{{ form_widget(form.postalCode, {'attr': {'placeholder': 'Code Postal', 'value' : postalCode is defined ? postalCode}}) }}
				{{ form_errors(form.postalCode) }}
			</div>
			<div>
				{{ form_widget(form.city, {'attr': {'placeholder': 'Ville', 'value': city is defined ? city}}) }}
				{{ form_errors(form.city) }}
			</div>
			<div>
				{{ form_widget(form.country, {'attr': {'placeholder': 'Pays', 'value': country is defined ? country}}) }}
				{{ form_errors(form.country) }}
			</div>
		</div>
	</div>

	<button type="submit" class="btn btn-secondary">{{ button_label|default('Créer') }}</button>

	{{ form_end(form) }}
{% endblock %}