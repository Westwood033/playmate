{% extends 'base.html.twig' %}

{% block title %}Playmate | Modifier le tournoi{% endblock %}

{% block body %}
	{% include 'header.html.twig' %}

	<main class="page">
		<div class="container container-md">
			<div class="card">
				<div class="auth-logo">
					<h1 class="brand-name">Playmate</h1>
					<p>Modifier le tournoi</p>
				</div>

				{{ include('tournament/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

				<div class="auth-footer">
					<a href="{{ path('app_tournament_index') }}">Retour à la liste</a>
				</div>

				{{ include('tournament/_delete_form.html.twig') }}
			</div>
		</div>
	</main>
{% endblock %}
