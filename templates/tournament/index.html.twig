{% extends 'base.html.twig' %}

{% block title %}Playmate | Tournois{% endblock %}

{% block body %}
	{% include 'header.html.twig' %}

	<main class="page">
		<div class="container">

			<div class="tournaments-header">
				<div class="tournaments-header__text">
					<h1>Tournois</h1>
					<p>{{ tournaments|length }} tournoi{{ tournaments|length != 1 ? 's' : '' }}</p>
				</div>
				{% if app.user and 'ROLE_SHOP' in app.user.roles %}
					<a href="{{ path('app_tournament_new', {id: app.user.id}) }}" class="btn-publish">
						<span class="btn-publish__icon">+</span>
						Créer un tournoi
					</a>
				{% endif %}
			</div>

			{% if tournaments is empty %}
				<div class="items-empty">
					<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
						<rect x="8" y="14" width="48" height="40" rx="4"/>
						<path d="M8 24h48M20 14V8M44 14V8"/>
					</svg>
					<p>Aucun tournoi pour le moment.</p>
					{% if app.user %}
						<a href="{{ path('app_tournament_new', {id: app.user.id}) }}">Créer le premier tournoi</a>
					{% endif %}
				</div>
			{% else %}
				<div class="tournaments-grid">
					{% for tournament in tournaments %}
						{% set isPast = tournament.tournamentDate and tournament.tournamentDate|date('U') < 'now'|date('U') %}
						<article class="tournament-card {{ isPast ? 'tournament-card--past' : '' }}">
							<div class="tournament-card__header">
								<div class="tournament-card__date-badge">
									{% if tournament.tournamentDate %}
										<span class="tournament-card__day">{{ tournament.tournamentDate|date('d') }}</span>
										<span class="tournament-card__month">{{ tournament.tournamentDate|date('M')|upper }}</span>
									{% else %}
										<span class="tournament-card__day">--</span>
										<span class="tournament-card__month">N/D</span>
									{% endif %}
								</div>

								 <div class="container tournament-card__badge_container">
                                {% if tournament.owner === app.user %}
									<span class="tournament-card__badge tournament-card__badge--created">Créé par vous</span>
								{% elseif app.user in tournament.users %}
									<span class="tournament-card__badge tournament-card__badge--registered">inscrit</span>
								{% endif %}

								{% if isPast %}
									<span class="tournament-card__badge tournament-card__badge--past">Terminé</span>
								{% else %}
									<span class="tournament-card__badge">À venir</span>
								{% endif %}
                                </div>
							</div>

							<h2 class="tournament-card__name">{{ tournament.name }}</h2>

							{% if tournament.description %}
								<p class="tournament-card__description">{{ tournament.description }}</p>
							{% endif %}

							<ul class="tournament-card__info">
								{% if tournament.address %}
									<li>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
											<circle cx="12" cy="10" r="3"/>
										</svg>
										<span>{{ tournament.address|replace({'|': " "}) }}</span>
									</li>
								{% endif %}
								<li>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
										<circle cx="9" cy="7" r="4"/>
										<path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
									</svg>
									<span>
										{{ tournament.users|length }}
										{% if tournament.participantNumber %} / {{ tournament.participantNumber }}{% endif %}
										participant{{ tournament.participantNumber > 1 ? 's' : '' }}
									</span>
								</li>
								{% if tournament.owner %}
									<li>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
											<circle cx="12" cy="7" r="4"/>
										</svg>
										<span>Organisé par {{ tournament.owner.username }}</span>
									</li>
								{% endif %}
							</ul>

							<div class="tournament-card__actions">
								<a href="{{ path('app_tournament_show', {id: tournament.id}) }}" class="btn-tournament-show">
									Voir le détail
								</a>
								{% if app.user and tournament.owner == app.user %}
									<a href="{{ path('app_tournament_edit', {id: tournament.id}) }}" class="btn-tournament-edit" title="Modifier">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
											<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
										</svg>
									</a>
								{% endif %}
							</div>
						</article>
					{% endfor %}
				</div>
			{% endif %}
		</div>
		<div class="flash-container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-notification flash-{{ label }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
	</main>

	<script>
    setTimeout(() => {
        document.querySelectorAll('.flash-notification').forEach(el => {
            el.style.transition = '0.5s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 500);
        });
    }, 5000);
</script>
{% endblock %}
