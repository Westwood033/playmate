{% set current_route = app.request.attributes.get('_route') %}

<header class="site-header">
	<div class="container">
		<div class="site-header-inner">
			<a href="{{ path('app_home') }}" class="brand">
				<span class="brand-mark">P</span>
				<span class="brand-name">Playmate</span>
			</a>

			{% if app.user %}
				<nav class="nav">

					<a href="{{ path('item_index') }}" class="{{ current_route == 'item_index' ? 'text-body' : 'text-muted' }}">
						TCG à l'achat
					</a>

					<a href="{{ path('app_tournament_index') }}" class="{{ current_route == 'app_tournament_index' ? 'text-body' : 'text-muted' }}">
							Tournois
						</a>

					<a href="{{ path('app_profile') }}" class="profile-header-link {{ current_route == 'app_profile' ? 'is-active text-body' : 'text-muted' }}">
						{% if app.user.avatar %}
							<span class="profile-header-link__avatar">
								<img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Avatar de {{ app.user.username }}">
							</span>
						{% else %}
							<span class="profile-header-link__placeholder">
								{{ app.user.username|first|upper }}
							</span>
						{% endif %}
					</a>

					<a href="{{ logout_path() }}" class="btn btn-secondary">
						Déconnexion
					</a>
				</nav>
			{% endif %}
		</div>
	</div>
</header>
