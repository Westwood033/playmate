{% set current_route = app.request.attributes.get('_route') %}

<header class="site-header">
	<div class="container">
		<div class="site-header-inner">
			<a href="{{ path('app_home') }}" class="brand">
				<span class="brand-mark">P</span>
				<span class="brand-name">Playmate</span>
			</a>

			{% if app.user %}
				<nav class="nav">
					{% if 'ROLE_SHOP' in app.user.roles %}
						<a href="{{ path('item_index') }}" class="{{ current_route == 'item_index' ? 'text-body' : 'text-muted' }}">
							Ma Boutique
						</a>
					{% else %}
						<a href="{{ path('app_shop_request') }}"
                           class="{% if app.request.getPathInfo() starts with path('app_shop_request') %}text-body{% else %}text-muted{% endif %}">
                            Devenir boutique
                    </a>
					{% endif %}

					<a href="{{ path('item_index') }}" class="{{ current_route == 'item_index' ? 'text-body' : 'text-muted' }}">
						TCG à l'achat
					</a>

					<a href="{{ path('app_tournament_index') }}"
						   class="{{ current_route starts with 'app_tournament' ? 'text-body' : 'text-muted' }}">
							Tournois
					</a>

					<a href="{{ logout_path() }}" class="btn btn-secondary">
						Déconnexion
					</a>
				</nav>
			{% endif %}
		</div>
	</div>
</header>
